# Copy to .env and chmod 600. Use literal absolute paths; no $HOME or shell code.
VNC_PASSFILE=/absolute/path/to/vnc.passwd
VNC_RESOLUTION=1366x768
# Unset ports/display are allocated automatically.
# VNC_PORT=5901
# REMOTE_DEBUG_PORT=9222
# VNC_DISPLAY=:99
# CHROME_BIN=/usr/bin/chromium
# PROXY_URL=http://127.0.0.1:3128
# NOVNC_PORT=6080
# NOVNC_WEB=/usr/share/novnc
# BROWSER_STATE_DIR=/absolute/private/state
# OUT_DIR=/absolute/private/artifacts
